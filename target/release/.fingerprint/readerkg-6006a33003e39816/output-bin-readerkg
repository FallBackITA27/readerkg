oo);\n}\n\nfn main() {\n    // Calling the method is still fine, as i32 implements Debug.\n    some_func(5i32);\n\n    // This would fail to compile now:\n    // struct WithoutDebug;\n    // some_func(WithoutDebug);\n}\n```\n\nRust only looks at the signature of the called function, as such it must\nalready specify all requirements that will be used for every type parameter.\n"},"level":"error","spans":[{"file_name":"src/main.rs","byte_start":5431,"byte_end":5448,"line_start":183,"line_end":183,"column_start":37,"column_end":54,"is_primary":true,"text":[{"text":"    writeln!(out, \"Date Set\\t: {}\", header.date_set()).unwrap();","highlight_start":37,"highlight_end":54}],"label":"`Date` cannot be formatted with the default formatter","suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"/home/falb/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/src/rust/library/core/src/macros/mod.rs","byte_start":22918,"byte_end":22951,"line_start":650,"line_end":650,"column_start":24,"column_end":57,"is_primary":false,"text":[{"text":"        $dst.write_fmt($crate::format_args_nl!($($arg)*))","highlight_start":24,"highlight_end":57}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"/home/falb/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/src/rust/library/core/src/macros/mod.rs","byte_start":22918,"byte_end":22951,"line_start":650,"line_end":650,"column_start":24,"column_end":57,"is_primary":false,"text":[{"text":"        $dst.write_fmt($crate::format_args_nl!($($arg)*))","highlight_start":24,"highlight_end":57}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"src/main.rs","byte_start":5399,"byte_end":5449,"line_start":183,"line_end":183,"column_start":5,"column_end":55,"is_primary":false,"text":[{"text":"    writeln!(out, \"Date Set\\t: {}\", header.date_set()).unwrap();","highlight_start":5,